# Python caches
__pycache__/
*.py[cod]

# Ambiente virtual e caches de ferramentas
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Cobertura de testes
.coverage
coverage.xml
htmlcov/

# Jupyter
.ipynb_checkpoints/
# Permitir versionar notebooks (apenas ignora checkpoints)

# MLflow local runs
mlruns/

# Artefatos de modelo: governança exclusiva via DVC (nunca versionar no Git).
models/*
!models/.gitkeep

# Reports and schedules (do not version)
report/

# Data (use external storage; commit samples only if needed)
dados/*.xlsx
dados/*.parquet
!dados/.gitkeep

# OS/editor
.DS_Store
Thumbs.db
.vscode/

# DVC local config (keep secrets local)
.dvc/config.local

# Dossiê interno (contém marca/PII real): manter apenas local.
references/

# Node/npm (if any dev tooling)
node_modules/