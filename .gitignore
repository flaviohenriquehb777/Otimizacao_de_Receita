# Python caches
__pycache__/
*.py[cod]

# Ambiente virtual e caches de ferramentas
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Cobertura de testes
.coverage
coverage.xml
htmlcov/

# Jupyter
.ipynb_checkpoints/
# Permitir versionar notebooks (apenas ignora checkpoints)

# MLflow local runs
mlruns/

# Models and artifacts (kept out of VCS; CI/DagsHub will track)
models/*.pkl
models/*.joblib
models/shap_summary.png

# Reports and schedules (do not version)
report/

# Data (use external storage; commit samples only if needed)
dados/*.xlsx
dados/*.parquet
!dados/.gitkeep

# OS/editor
.DS_Store
Thumbs.db
.vscode/

# DVC local config (keep secrets local)
.dvc/config.local

# Node/npm (if any dev tooling)
node_modules/